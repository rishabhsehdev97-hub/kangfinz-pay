        "upiId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name"]
    },
    "BankAccounts": {
      "title": "BankAccounts",
      "description": "Linked bank accounts and balances",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bankName": { "type": "string" },
        "accountType": { "type": "string" },
        "accountNumberLast4": { "type": "string" },
