{
  "entities": {
    "Users": {
      "title": "Users",
      "description": "User profiles and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "kycVerified": { "type": "boolean" },
